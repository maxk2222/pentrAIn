# pentrAIn platform environment — generated by the installer.
# Backend/coach read PENTRAIN_* vars (env_prefix=PENTRAIN_); APP_PORT is used
# by compose for the published port.
PENTRAIN_APP_SECRET={{ lookup('ansible.builtin.password', playbook_dir + '/.secrets/app_secret', chars=['ascii_letters','digits'], length=48) }}
PENTRAIN_COACH_SERVICE_TOKEN={{ lookup('ansible.builtin.password', playbook_dir + '/.secrets/coach_token', chars=['ascii_letters','digits'], length=32) }}
PENTRAIN_ENGINE_MODE={{ install_mode }}
APP_PORT={{ platform_http_port }}
